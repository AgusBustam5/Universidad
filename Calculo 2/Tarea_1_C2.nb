Cell[BoxData[{
 RowBox[{
  RowBox[{"LogLocal", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{"Picewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p10", "[", 
        RowBox[{"x", "-", "1"}], "]"}], ",", " ", 
       RowBox[{"0.5", " ", "<=", " ", "x", " ", "<=", " ", "1.5"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"-", "Infinity"}], " ", "<", " ", "x", " ", "<", " ", 
        "0.5"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
