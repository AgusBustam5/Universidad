   RowBox[{"{", 
    RowBox[{"TME", ",", " ", "ReE"}], "}"}], " ", "=", " ", 
   RowBox[{"Timing", "[", 
    RowBox[{"NestList", "[", 
     RowBox[{"SDstep", ",", " ", "x0", ",", " ", "30"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReFinalE", " ", "=", " ", 
   RowBox[{"Last", "[", "ReE", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fiFinME", " ", "=", " ", 
  RowBox[{"f", " ", "@@", " ", "ReFinalE"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"TMM", ",", " ", "ReM"}], "}"}], " ", "=", " ", 
