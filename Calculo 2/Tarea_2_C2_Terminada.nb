    RowBox[{"NestList", "[", 
     RowBox[{"SDstepMejorado", ",", " ", "x0", ",", " ", "30"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReFinalM", " ", ":=", " ", 
   RowBox[{"Last", "[", "ReM", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fFinMM", " ", "=", " ", 
  RowBox[{"f", " ", "@@", " ", "ReFinalM"}]}], "\[IndentingNewLine]", 
 RowBox[{"print", "[", 
  RowBox[{"TME", ",", "TMM"}], "]"}]}], "Input",
