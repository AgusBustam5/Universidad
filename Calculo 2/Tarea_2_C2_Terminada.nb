Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "y"}], ")"}], "^", "2"}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"E", "^", "y"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", "z", "-", "2"}], ")"}]}], "]"}], "^", 
     "2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradex", " ", ":=", " ", 
   RowBox[{
    RowBox[{"Grad", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"gradex", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessexp", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "2"}], "}"}]}], "]"}],
     " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"hessexp", " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
           RowBox[{"_", ",", 
            RowBox[{"{", 
             RowBox[{"Rule", "[", 
              RowBox[{"_", ",", "_"}], "]"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"tStar", "=", 
          RowBox[{"t", "/.", " ", 
           RowBox[{"Last", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
         " ", 
         RowBox[{"N", "[", 
          RowBox[{"x", "-", 
           RowBox[{"tStar", "*", "g"}]}], "]"}]}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"x", "-", 
          RowBox[{"0.1", "*", "g"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SDstepMejorado", "[", "x_List", "]"}], " ", ":=", " ", 
