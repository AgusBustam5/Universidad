Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", " ", "+", " ", 
      RowBox[{"b", "*", 
       RowBox[{"Sin", "[", "c", "]"}]}], " ", "-", " ", "0.92"}], ")"}], "^", 
    "2"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "*", "a"}], " ", "+", " ", 
      RowBox[{"b", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "*", "c"}], "]"}]}], " ", "-", " ", "1.16"}], ")"}], "^",
     "2"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", "a"}], " ", "+", " ", 
      RowBox[{"b", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"3", "*", "c"}], "]"}]}], " ", "-", " ", "0.79"}], ")"}], "^",
     "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"gradex", " ", ":=", " ", 
  RowBox[{
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"a", ",", "b", ",", "c"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"gradex", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], "->", "li"}], "]"}]}], 
    "]"}], "//", "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
