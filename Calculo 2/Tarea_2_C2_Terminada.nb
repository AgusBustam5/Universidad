Cell["\<\
Podemos apreciar que la funcion nueva, no solamente es mas r\[AAcute]pida, si \
no que tambi\[EAcute]n resulta mas precisa para el calculo ya que se aproxima \
mucho mas al valor esperado utilizando la misma cantidad de pasos que la \
original\
\>", "Text",
 CellChangeTimes->{{3.971381269488558*^9, 
  3.97138132635211*^9}},ExpressionUUID->"ddc767ac-129c-f24d-b3e7-\
3a1dd97a6f83"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Adicional 2", "Subsubsection",
 CellChangeTimes->{{3.971378653648031*^9, 
  3.971378655833233*^9}},ExpressionUUID->"c5c09f0a-4bd2-1342-a460-\
79ffce8d48c7"],

Cell["Realizamos el mismo procedimiento que con anterioridad", "Text",
 CellChangeTimes->{{3.9713813560415688`*^9, 
  3.971381369826515*^9}},ExpressionUUID->"da729f17-0e48-1445-9a54-\
5002493fe24a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "y", "+", "z"}], ")"}], "^", "2"}], "]"}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x", "+", "y", "-", "2"}], "]"}], "^", "2"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "^", "2"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"y", "^", "4"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradex", " ", ":=", " ", 
   RowBox[{
    RowBox[{"Grad", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"gradex", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessexp", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "2"}], "}"}]}], "]"}],
     " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"hessexp", " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
           RowBox[{"_", ",", 
            RowBox[{"{", 
             RowBox[{"Rule", "[", 
              RowBox[{"_", ",", "_"}], "]"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"tStar", "=", 
          RowBox[{"t", "/.", " ", 
           RowBox[{"Last", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
         " ", 
         RowBox[{"N", "[", 
          RowBox[{"x", "-", 
           RowBox[{"tStar", "*", "g"}]}], "]"}]}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"x", "-", 
          RowBox[{"0.1", "*", "g"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
"\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SDstepMejorado", "[", "x_List", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", " ", "H", ",", " ", "tStar"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"g", " ", "=", 
      RowBox[{"N", "[", 
       RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h", "=", 
      RowBox[{"N", "[", 
       RowBox[{"hessf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tStar", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"g", ".", "g"}], ")"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"g", ".", "h", ".", "g"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"x", "-", 
       RowBox[{"tStar", "*", "g"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.8", ",", " ", "1.3", ",", "0.2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SDsecuenciaE", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{"SDstep", ",", "x0", ",", "20"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SDsecuenciaM", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{"SDstepMejorado", ",", "x0", ",", "20"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"f", "@@", 
  RowBox[{"Last", "[", "SDsecuenciaE", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"f", "@@", 
  RowBox[{"Last", "[", "SDsecuenciaM", "]"}]}]}], "Input",
 CellChangeTimes->{
