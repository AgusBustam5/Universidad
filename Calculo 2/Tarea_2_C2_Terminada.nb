Cell[BoxData[{
 RowBox[{
  RowBox[{"GrafE", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", " ", "@@", " ", "#"}], " ", "&"}], ",", " ", "ReE"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrafM", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", " ", "@@", " ", "#"}], " ", "&"}], ",", " ", "ReM"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"GrafE", ",", "GrafM"}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Paso(x)\>\"", ",", " ", "\"\<Valor:f(x)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
