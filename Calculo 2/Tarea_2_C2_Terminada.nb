Cell["Ejercicio 3", "Subsubsection",
 CellChangeTimes->{{3.97137859077775*^9, 3.97137859373814*^9}, 
   3.971378692063692*^9},ExpressionUUID->"3ae808de-a774-1644-8439-\
7417155d05d6"],

Cell["\<\
Definimos la funcion y el gradiente de la misma forma que en las anteriores\
\>", "Text",
 CellChangeTimes->{{3.9713803448306103`*^9, 
  3.971380362892475*^9}},ExpressionUUID->"9a34e3dc-a6bd-4a40-bb64-\
3c41c6ff8ff0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"3", "*", "y"}], " ", "-", " ", "5"}], ")"}], "^", "2"}], " ", "+",
    " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "-", 
      RowBox[{"2", "*", "y"}]}], ")"}], "^", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"gradex", " ", "=", " ", 
  RowBox[{
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "//", "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"gradex", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], "->", "li"}], "]"}]}], "]"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
           RowBox[{"_", ",", 
            RowBox[{"{", 
             RowBox[{"Rule", "[", 
              RowBox[{"_", ",", "_"}], "]"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"tStar", "=", 
          RowBox[{"t", "/.", " ", 
           RowBox[{"Last", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
         " ", 
         RowBox[{"N", "[", 
          RowBox[{"x", "-", 
           RowBox[{"tStar", "*", "g"}]}], "]"}]}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"x", "-", 
          RowBox[{"0.1", "*", "g"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.971369751235031*^9, 3.97136982700404*^9}},
 CellLabel->
  "In[822]:=",ExpressionUUID->"87018ab1-6f49-d74a-aa13-3988934dbd9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "5"}], "+", 
      RowBox[{"2", " ", "x"}], "+", "y"}], ")"}]}], ",", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "15"}], "+", "x", "+", 
      RowBox[{"13", " ", "y"}]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9713698594417496`*^9, 3.9713754522787476`*^9, 
