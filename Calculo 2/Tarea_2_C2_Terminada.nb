Cell["\<\
Partimos definiendo la funciones necesaria para el primer ejercicio, siendo \
esta la funcion \[OpenCurlyDoubleQuote]f\[CloseCurlyDoubleQuote]. Definimos \
el gradiente simb\[OAcute]lico de la funcion y luego se define nuevamente \
pero como funcion num\[EAcute]rica, para despues definir la funcion SDstep.\
\>", "Text",
 CellChangeTimes->{{3.971378767979397*^9, 3.971378824313406*^9}, {
  3.9713788585982265`*^9, 3.9713789460923347`*^9}, {3.9713795392912407`*^9, 
  3.971379545990118*^9}},ExpressionUUID->"84cf394c-963e-a748-8f7b-\
1c28152d74ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"y", "-", "x", "+", "z"}], ")"}], "^", "2"}], ")"}], " ", "+", 
   " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "*", "x"}], "-", 
       RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], ")"}], " ", "+", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"6", "-", "x", "-", "z", "-", 
       RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"gradex", " ", "=", " ", 
  RowBox[{
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"gradex", "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
    "]"}], "//", "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
           RowBox[{"_", ",", 
            RowBox[{"{", 
             RowBox[{"Rule", "[", 
              RowBox[{"_", ",", "_"}], "]"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"tStar", "=", 
          RowBox[{"t", "/.", " ", 
           RowBox[{"Last", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
         " ", 
         RowBox[{"N", "[", 
          RowBox[{"x", "-", 
           RowBox[{"tStar", "*", "g"}]}], "]"}]}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"x", "-", 
          RowBox[{"0.1", "*", "g"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.971244973266073*^9, 3.971244978007162*^9}, {
  3.9712450271429005`*^9, 3.9712450436476765`*^9}, {3.9712452948484573`*^9, 
