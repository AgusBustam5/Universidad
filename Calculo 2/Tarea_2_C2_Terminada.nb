Cell["\<\
Definimos las funciones ncesarias, el gradiente y la Hessiana\
\>", "Text",
 CellChangeTimes->{{3.971380837495758*^9, 
  3.971380855125248*^9}},ExpressionUUID->"9e9d5dad-3451-884e-8ea2-\
f5c3189b87a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"y", "-", "x", "+", "z"}], ")"}], "^", "2"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "*", "x"}], " ", "-", " ", 
       RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"6", " ", "-", " ", "x", " ", "-", " ", 
       RowBox[{"y", "^", "2"}], " ", "-", "z"}], ")"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradex", " ", ":=", " ", 
   RowBox[{
    RowBox[{"Grad", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"gradex", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessexp", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "2"}], "}"}]}], "]"}],
     " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessf", "[", "li_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"hessexp", " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "li"}], "]"}]}], 
     "]"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SDstep", "[", "x_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", " ", "phi", ",", "sol", ",", "tStar"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"f", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"t", "*", "g"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"sol", "=", " ", 
         RowBox[{"FindMinimum", "[", 
          RowBox[{
           RowBox[{"phi", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"sol", ",", " ", 
          RowBox[{"{", 
           RowBox[{"_", ",", 
            RowBox[{"{", 
             RowBox[{"Rule", "[", 
              RowBox[{"_", ",", "_"}], "]"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"tStar", "=", 
          RowBox[{"t", "/.", " ", 
           RowBox[{"Last", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
         " ", 
         RowBox[{"N", "[", 
          RowBox[{"x", "-", 
           RowBox[{"tStar", "*", "g"}]}], "]"}]}], ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"x", "-", 
          RowBox[{"0.1", "*", "g"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SDstepMejorado", "[", "x_List", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", " ", "H", ",", " ", "tStar"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"g", " ", "=", 
      RowBox[{"N", "[", 
       RowBox[{"gradf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h", "=", 
      RowBox[{"N", "[", 
       RowBox[{"hessf", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tStar", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"g", ".", "g"}], ")"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"g", ".", "h", ".", "g"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"x", "-", 
       RowBox[{"tStar", "*", "g"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9713707323452187`*^9, 3.9713708908945465`*^9}, {
  3.971370930691141*^9, 3.9713709425250397`*^9}, {3.971371043841017*^9, 
  3.9713711872361603`*^9}, {3.971371225645197*^9, 3.971371241520956*^9}, {
  3.9713712746376553`*^9, 3.9713714057250214`*^9}, {3.9713727325409184`*^9, 
  3.971372753581106*^9}},
 CellLabel->
  "In[831]:=",ExpressionUUID->"b585cf84-b2ab-7443-83e6-e7bd4d438ffa"],

Cell["\<\
Se ejecutan ambos m\[EAcute]todos en las coordenadas dadas, con 30 pasos y \
utilizamos la funcion Timing para comparar la eficiencia de ambos metodos\
\>", "Text",
 CellChangeTimes->{{3.9713808852441006`*^9, 
